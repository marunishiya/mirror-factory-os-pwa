{
  "name": "mirror-social-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "triggers": {"crons": ["* * * * *"]},
  "vars": {
    "VIDEO_QUEUE_ENABLED": "false",
    "LIVE_PUBLISHING_ENABLED": "false",
    "VIDEO_LIVE_ENABLED": "false",
    "VIDEO_DISPATCH_APPROVED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mirror-social-db",
      "database_id": "e76938e0-9c61-4a25-b84c-452930f698f3"
    }
  ]
}
